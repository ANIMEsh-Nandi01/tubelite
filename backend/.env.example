# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Database — replace with your PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/tubelite

# JWT — generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-very-strong-secret-here-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=tubelite
R2_PUBLIC_URL=https://your-custom-domain.r2.dev

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000
